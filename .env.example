# Copie para .env e gere valores aleatórios. Nunca versione o arquivo preenchido.
DB_PASSWORD=
ADMIN_PASSWORD=
LOCAL_PORT=8080
# HTTP somente em loopback. Use true ao habilitar acesso remoto por HTTPS.
SECURE_COOKIES=false
NODE_MODE=Authority
DEVICE_ID=local-bar-01
AUTHORITY_DEVICE_ID=local-bar-01
# URL HTTPS da instalação em OUTRO equipamento; nunca a própria autoridade.
SYNC_REMOTE_URL=
SYNC_KEY=
PUBLIC_DOMAIN=
# Backup criptografado enviado por rclone a armazenamento independente.
AGE_RECIPIENT=
BACKUP_REMOTE=
BACKUP_STATUS_KEY=
RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=3600
